{
  "name": "ssplayer-for-web-monorepo",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm -r --filter=!docs run build",
    "docs": "pnpm run build && pnpm --filter=docs run build",
    "build:wasm": "node scripts/build-wasm.js",
    "download:wasm": "node scripts/download-sdk.js",
    "deploy-examples": "node scripts/deploy-examples.js",
    "example": "node scripts/run-example.js",
    "sync:docs": "node scripts/sync-doc-versions.mjs",
    "check:docs": "node scripts/sync-doc-versions.mjs --check",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "rimraf": "^6.1.4",
    "tsdown": "0.23.5",
    "typescript": "^7.0.2"
  },
  "license": "BSD-3-Clause"
}
