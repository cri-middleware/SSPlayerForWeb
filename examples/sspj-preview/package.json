{
  "name": "sspj-preview",
  "private": true,
  "version": "1.0.0",
  "description": "Drop a SpriteStudio project (.sspj) folder and play it — conversion (ssconverter-core) and playback (ssplayer-webgl or ssplayer-pixi) in one page, no build step",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "license": "BSD-3-Clause",
  "type": "module",
  "dependencies": {
    "@spritestudio/ssconverter-core": "workspace:*",
    "@spritestudio/ssplayer-pixi": "workspace:*",
    "@spritestudio/ssplayer-webgl": "workspace:*",
    "pixi.js": "^8.23.0"
  },
  "devDependencies": {
    "@spritestudio/ssplayer-core": "workspace:*",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.1.0"
  }
}
