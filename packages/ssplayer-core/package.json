{
  "name": "@spritestudio/ssplayer-core",
  "version": "1.0.0",
  "description": "Engine-agnostic WebAssembly core for SpriteStudio7-SDK player",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./wasm/*": "./wasm/*"
  },
  "scripts": {
    "build": "tsdown && cp wasm/*.wasm dist/",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "flatbuffers": "^25.9.23"
  },
  "license": "BSD-3-Clause"
}
