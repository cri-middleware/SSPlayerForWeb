{
  "name": "@spritestudio/ssplayer-core",
  "version": "7.0.0-beta.1",
  "description": "Engine-agnostic WebAssembly core of SpriteStudio Player for Web: plays SpriteStudio animations (.ssab) and hands each frame to a renderer as draw data, for building your own renderer.",
  "keywords": [
    "spritestudio",
    "spritestudio7",
    "animation",
    "2d",
    "sprite",
    "skeletal-animation",
    "gamedev",
    "webassembly",
    "wasm"
  ],
  "author": "CRI Middleware Co., Ltd.",
  "homepage": "https://cri-middleware.github.io/SSPlayerForWeb/api-guide",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cri-middleware/SSPlayerForWeb.git",
    "directory": "packages/ssplayer-core"
  },
  "bugs": {
    "url": "https://github.com/cri-middleware/SSPlayerForWeb/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "import": "./dist/audio.js"
    },
    "./wasm/*": "./wasm/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "wasm",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "LICENSE.ja.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && copyfiles -u 1 \"wasm/*.wasm\" dist/ && node ../../scripts/copy-docs.mjs docs skills/ssplayer-core",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist docs skills",
    "test": "vitest run",
    "prepack": "node ../../scripts/verify-publish-artifacts.mjs"
  },
  "devDependencies": {
    "@spritestudio/ssconverter-core": "workspace:*",
    "copyfiles": "^2.4.1",
    "flatbuffers": "^25.9.23",
    "vitest": "^5.1.2"
  },
  "license": "BSD-3-Clause"
}
