{
  "name": "@spritestudio/ssplayer-core",
  "version": "1.0.0",
  "description": "Engine-agnostic WebAssembly core for SpriteStudio-SDK player",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./wasm/*": "./wasm/*"
  },
  "scripts": {
    "build": "tsdown && cp wasm/*.wasm dist/",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "flatbuffers": "^25.9.23",
    "vitest": "^3.0.0"
  },
  "license": "BSD-3-Clause"
}
