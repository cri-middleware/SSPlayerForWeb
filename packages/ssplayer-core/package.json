{
  "name": "@spritestudio/ssplayer-core",
  "version": "7.0.0-beta.1",
  "description": "Engine-agnostic WebAssembly core for SpriteStudio-SDK player",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./wasm/*": "./wasm/*"
  },
  "files": [
    "dist",
    "wasm",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && copyfiles -u 1 \"wasm/*.wasm\" dist/",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "flatbuffers": "^25.9.23",
    "vitest": "^4.1.9"
  },
  "license": "BSD-3-Clause"
}
