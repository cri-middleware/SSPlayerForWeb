{
  "name": "@spritestudio/ssplayer-core",
  "version": "7.0.0-beta.1",
  "description": "Engine-agnostic WebAssembly core for SpriteStudio-SDK player",
  "keywords": [
    "spritestudio",
    "spritestudio7",
    "animation",
    "2d",
    "webassembly",
    "wasm",
    "runtime",
    "player"
  ],
  "author": "CRI Middleware Co., Ltd.",
  "homepage": "https://github.com/cri-middleware/SSPlayerForWeb/tree/main/packages/ssplayer-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cri-middleware/SSPlayerForWeb.git",
    "directory": "packages/ssplayer-core"
  },
  "bugs": {
    "url": "https://github.com/cri-middleware/SSPlayerForWeb/issues"
  },
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./wasm/*": "./wasm/*"
  },
  "files": [
    "dist",
    "wasm",
    "README.md",
    "README.ja.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && copyfiles -u 1 \"wasm/*.wasm\" dist/",
    "clean": "rimraf dist",
    "test": "vitest run",
    "prepack": "node ../../scripts/verify-publish-artifacts.mjs"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "flatbuffers": "^25.9.23",
    "vitest": "^4.1.9"
  },
  "license": "BSD-3-Clause"
}
