{
  "name": "@spritestudio/ssplayer-webgl",
  "version": "7.0.0-beta.1",
  "description": "Zero-dependency, ad-grade WebGL1/2 renderer for SpriteStudio-SDK player",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lite": {
      "import": "./dist/lite.js",
      "types": "./dist/lite.d.ts"
    },
    "./element": {
      "import": "./dist/element.js",
      "types": "./dist/element.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@spritestudio/ssplayer-core": "workspace:*"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "size": "node scripts/measure-size.mjs"
  },
  "license": "BSD-3-Clause",
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
