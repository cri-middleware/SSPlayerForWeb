{
  "name": "@spritestudio/ssplayer-webgl",
  "version": "7.0.0-beta.1",
  "description": "SpriteStudio Player for Web on WebGL 1/2: plays SpriteStudio animations (.ssab) on a canvas or as an <ss-player> element, with no dependencies.",
  "keywords": [
    "spritestudio",
    "spritestudio7",
    "animation",
    "2d",
    "sprite",
    "skeletal-animation",
    "gamedev",
    "webgl",
    "canvas",
    "web-component",
    "custom-element",
    "webassembly",
    "wasm",
    "zero-dependency"
  ],
  "author": "CRI Middleware Co., Ltd.",
  "homepage": "https://cri-middleware.github.io/SSPlayerForWeb/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cri-middleware/SSPlayerForWeb.git",
    "directory": "packages/ssplayer-webgl"
  },
  "bugs": {
    "url": "https://github.com/cri-middleware/SSPlayerForWeb/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/browser/ssplayer-webgl.browser.min.js",
  "jsdelivr": "./dist/browser/ssplayer-webgl.browser.min.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "import": "./dist/lite.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./package.json": "./package.json"
  },
  "//typesVersions": "TypeScript only reads `exports` under moduleResolution bundler/node16+. Projects still on the legacy `\"node\"` resolution (common even when the bundler itself is Vite, which resolves the runtime import fine) would fail to find the ./lite and ./element subpaths. This maps them the old way so those projects typecheck.",
  "typesVersions": {
    "*": {
      "lite": ["./dist/lite.d.ts"],
      "element": ["./dist/element.d.ts"]
    }
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "LICENSE.ja.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@spritestudio/ssplayer-core": "workspace:^"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/copy-docs.mjs docs skills/ssplayer-webgl",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist docs skills",
    "size": "node scripts/measure-size.mjs",
    "test": "vitest run",
    "prepack": "node ../../scripts/verify-publish-artifacts.mjs"
  },
  "license": "BSD-3-Clause",
  "devDependencies": {
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
