{
  "name": "@spritestudio/ssplayer-pixi-ui",
  "version": "7.0.0-beta.1",
  "description": "SpriteStudio Player for Web on PixiJS v8, as UI: a SpriteStudio animation as a @pixi/ui button whose states play its labels, hit-tested on its parts.",
  "keywords": [
    "spritestudio",
    "spritestudio7",
    "animation",
    "2d",
    "ui",
    "button",
    "pixijs",
    "pixi",
    "pixi-ui",
    "accessibility"
  ],
  "author": "CRI Middleware Co., Ltd.",
  "homepage": "https://github.com/cri-middleware/SSPlayerForWeb/tree/main/packages/ssplayer-pixi-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cri-middleware/SSPlayerForWeb.git",
    "directory": "packages/ssplayer-pixi-ui"
  },
  "bugs": {
    "url": "https://github.com/cri-middleware/SSPlayerForWeb/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "LICENSE.ja.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@pixi/ui": "^2.4.1",
    "pixi.js": "^8.19.0"
  },
  "dependencies": {
    "@spritestudio/ssplayer-pixi": "workspace:^"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/copy-docs.mjs docs skills/ssplayer-pixi-ui",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist docs skills",
    "test": "vitest run",
    "prepack": "node ../../scripts/verify-publish-artifacts.mjs"
  },
  "devDependencies": {
    "@pixi/ui": "^2.4.1",
    "jsdom": "^31.0.1",
    "pixi.js": "^8.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "license": "BSD-3-Clause"
}
