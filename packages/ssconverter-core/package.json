{
  "name": "@spritestudio/ssconverter-core",
  "version": "7.0.0-beta.1",
  "description": "WebAssembly build of the SpriteStudio converter: turns SpriteStudio projects (.sspj) into the .ssab and .ssqb the players load, bytes in and bytes out, in a browser or in Node.",
  "keywords": [
    "spritestudio",
    "spritestudio7",
    "converter",
    "sspj",
    "ssab",
    "ssqb",
    "animation",
    "webassembly",
    "wasm"
  ],
  "author": "CRI Middleware Co., Ltd.",
  "homepage": "https://github.com/cri-middleware/SSPlayerForWeb/tree/main/packages/ssconverter-core#readme",
  "bugs": {
    "url": "https://github.com/cri-middleware/SSPlayerForWeb/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm/*": "./wasm/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "wasm",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "LICENSE.ja.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cri-middleware/SSPlayerForWeb.git",
    "directory": "packages/ssconverter-core"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/copy-docs.mjs docs skills/ssconverter-core",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist docs skills",
    "test": "vitest run",
    "prepack": "node ../../scripts/verify-publish-artifacts.mjs"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  },
  "license": "BSD-3-Clause"
}
