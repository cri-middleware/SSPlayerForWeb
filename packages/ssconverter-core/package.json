{
  "name": "@spritestudio/ssconverter-core",
  "version": "7.0.0-beta.1",
  "description": "Environment-agnostic WebAssembly core (wasm build of the Rust libssconverter crate) that converts SpriteStudio projects (.sspj) to binaries (.ssab/.ssqb)",
  "keywords": [
    "spritestudio",
    "spritestudio7",
    "converter",
    "sspj",
    "ssab",
    "ssqb",
    "webassembly",
    "wasm"
  ],
  "author": "CRI Middleware Co., Ltd.",
  "homepage": "https://github.com/cri-middleware/SSPlayerForWeb/tree/main/packages/ssconverter-core#readme",
  "bugs": {
    "url": "https://github.com/cri-middleware/SSPlayerForWeb/issues"
  },
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./wasm/*": "./wasm/*"
  },
  "files": [
    "dist",
    "wasm",
    "README.md",
    "README.ja.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cri-middleware/SSPlayerForWeb.git",
    "directory": "packages/ssconverter-core"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "test": "vitest run",
    "prepack": "node ../../scripts/verify-publish-artifacts.mjs"
  },
  "devDependencies": {
    "vitest": "^4.1.9"
  },
  "license": "BSD-3-Clause"
}
