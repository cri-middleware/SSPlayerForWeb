{
  "name": "@spritestudio/ssplayer-pixi",
  "version": "7.0.0-beta.1",
  "description": "SpriteStudio Player for Web on PixiJS v8: plays SpriteStudio animations (.ssab) as a Pixi Container, drawn through Pixi's own batching.",
  "keywords": [
    "spritestudio",
    "spritestudio7",
    "animation",
    "2d",
    "sprite",
    "skeletal-animation",
    "gamedev",
    "pixijs",
    "pixi",
    "webgl",
    "webgpu",
    "webassembly",
    "wasm"
  ],
  "author": "CRI Middleware Co., Ltd.",
  "homepage": "https://github.com/cri-middleware/SSPlayerForWeb/tree/main/packages/ssplayer-pixi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cri-middleware/SSPlayerForWeb.git",
    "directory": "packages/ssplayer-pixi"
  },
  "bugs": {
    "url": "https://github.com/cri-middleware/SSPlayerForWeb/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "unpkg": "./dist/browser/ssplayer-pixi.browser.min.js",
  "jsdelivr": "./dist/browser/ssplayer-pixi.browser.min.js",
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "LICENSE.ja.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "pixi.js": "^8.19.0"
  },
  "dependencies": {
    "@spritestudio/ssplayer-core": "workspace:^"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/copy-docs.mjs docs",
    "clean": "rimraf dist docs",
    "test": "vitest run",
    "prepack": "node ../../scripts/verify-publish-artifacts.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "pixi.js": "^8.22.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "BSD-3-Clause"
}
