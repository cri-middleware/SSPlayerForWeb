{
  "name": "@spritestudio/ssplayer-pixi",
  "version": "7.0.0-beta.1",
  "description": "PixiJS renderer for SpriteStudio-SDK player",
  "keywords": [
    "spritestudio",
    "spritestudio7",
    "animation",
    "2d",
    "pixijs",
    "pixi",
    "webgl",
    "player",
    "wasm"
  ],
  "author": "CRI Middleware Co., Ltd.",
  "homepage": "https://github.com/cri-middleware/SSPlayerForWeb/tree/main/packages/ssplayer-pixi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cri-middleware/SSPlayerForWeb.git",
    "directory": "packages/ssplayer-pixi"
  },
  "bugs": {
    "url": "https://github.com/cri-middleware/SSPlayerForWeb/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "unpkg": "./dist/browser/ssplayer-pixi.browser.min.js",
  "jsdelivr": "./dist/browser/ssplayer-pixi.browser.min.js",
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE.md",
    "LICENSE.ja.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "pixi.js": "^8.19.0"
  },
  "dependencies": {
    "@spritestudio/ssplayer-core": "workspace:^"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "test": "vitest run",
    "prepack": "node ../../scripts/verify-publish-artifacts.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "pixi.js": "^8.22.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "license": "BSD-3-Clause"
}
